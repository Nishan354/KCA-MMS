{
  "name": "kca-mms-db",
  "version": "1.0.0",
  "description": "KCA Fujairah Membership Management System & Digital Registry",
  "author": "Kairali Cultural Association Fujairah <info@kcafujairah.com>",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "start": "tsx server.ts",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "ELECTRON_DEV=true electron electron/main.cjs",
    "electron:build": "vite build",
    "dist": "node electron/prepareIcon.cjs && vite build && electron-builder",
    "dist:win": "node electron/prepareIcon.cjs && vite build && electron-builder --win",
    "dist:dir": "node electron/prepareIcon.cjs && vite build && electron-builder --dir"
  },
  "build": {
    "appId": "org.kcafujairah.mms",
    "productName": "KCA-MMS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KCA-MMS"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.2"
  }
}